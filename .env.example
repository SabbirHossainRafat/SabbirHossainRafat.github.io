# ============================================================
# SABBIR HOSSAIN RAFAT — Portfolio Backend Environment
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Flask ──
FLASK_ENV=development
PORT=5000
FLASK_SECRET_KEY=change-this-to-a-random-64-character-string-before-deploying

# ── CORS ──
# Comma-separated list of allowed frontend origins.
# Use * only for local development. Set exact origin in production.
CORS_ORIGINS=http://localhost:3000,https://sabbirrafat.dev

# ── Rate Limiting ──
# Maximum contact form submissions allowed per IP per time window.
# For multi-worker gunicorn deployments, set storage_uri to Redis in app.py.
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=3600

# ── Gemini AI ──
# Get a free API key at https://aistudio.google.com
# 1. Sign in with your Google account
# 2. Click Get API Key → Create API Key
# 3. Copy the key and paste it below
# This key is only read server-side and never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── GitHub API ──
# Optional. Without a token, GitHub API allows 60 requests/hour per IP.
# With a token, the limit increases to 5000 requests/hour.
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your-github-token-here

# ── Email Notifications ──
# Optional. If configured, sends an email when the contact form is submitted.
# For Gmail, use an App Password (not your account password):
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-specific-password
TO_EMAIL=sabbirrafat369@gmail.com

# ── Discord Webhook ──
# Optional. If configured, sends a Discord notification on form submission.
# Create a webhook in your Discord server: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# ── Slack Webhook ──
# Optional. If configured, sends a Slack notification on form submission.
# Create a webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=